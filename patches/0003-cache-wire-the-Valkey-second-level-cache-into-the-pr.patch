From: Salty <99386653+PjSalty@users.noreply.github.com>
Date: Sat, 26 Sep 2026 19:12:52 -0500
Subject: [PATCH 03/11] cache: wire the Valkey second level cache into the
 provider

Intent: register the cache interceptor on the DbContextOptionsBuilder inside
Initialise (covers every pooled context) and flush the cache after
PurgeDatabase, whose table purge statements the interceptor cannot see.
Fail open: any cache bootstrap failure logs a warning and the server runs
uncached; tight 500ms cache timeouts cap the stall a slow-but-alive cache
can cause (the library still runs every cache read synchronously under one
lock per interception result type, waiting up to its 7s lock timeout before
it proceeds unlocked). Off by default, enabled via CACHE_ENABLED.
Drop when: upstream accepts an equivalent hook.
---
 .../Database/PgSqlDatabaseProvider.cs         | 24 +++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/Jellyfin.Plugin.Pgsql/Database/PgSqlDatabaseProvider.cs b/Jellyfin.Plugin.Pgsql/Database/PgSqlDatabaseProvider.cs
index a28df3e..7f00f2d 100644
--- a/Jellyfin.Plugin.Pgsql/Database/PgSqlDatabaseProvider.cs
+++ b/Jellyfin.Plugin.Pgsql/Database/PgSqlDatabaseProvider.cs
@@ -9,6 +9,7 @@ using System.Threading;
 using System.Threading.Tasks;
 using Jellyfin.Database.Implementations;
 using Jellyfin.Database.Implementations.DbConfiguration;
+using Jellyfin.Plugin.Pgsql.Cache;
 using MediaBrowser.Common.Configuration;
 using MediaBrowser.Controller.Configuration;
 using Microsoft.EntityFrameworkCore;
@@ -61,6 +62,25 @@ public sealed class PgSqlDatabaseProvider : IJellyfinDatabaseProvider
             options.EnableSensitiveDataLogging(enableSensitiveDataLogging);
             _logger.LogInformation("EnableSensitiveDataLogging is enabled on PostgreSQL connection");
         }
+
+        var cacheConfiguration = ValkeyCacheConfig.Load(customOptions);
+        if (cacheConfiguration.Enabled)
+        {
+            try
+            {
+                options.AddInterceptors(SecondLevelCacheFactory.GetOrCreate(cacheConfiguration, _logger));
+                _logger.LogInformation(
+                    "EF second level cache enabled on Valkey {Host}:{Port}, ttl {Ttl} minutes, {ExcludedCount} tables excluded",
+                    cacheConfiguration.Host,
+                    cacheConfiguration.Port,
+                    cacheConfiguration.TtlMinutes,
+                    cacheConfiguration.ExcludedTables.Count);
+            }
+            catch (Exception ex)
+            {
+                _logger.LogWarning(ex, "EF second level cache bootstrap failed, continuing without caching");
+            }
+        }
     }
 
     /// <inheritdoc/>
@@ -247,6 +267,10 @@ public sealed class PgSqlDatabaseProvider : IJellyfinDatabaseProvider
 
         await dbContext.Database.ExecuteSqlRawAsync(truncateAllQuery).ConfigureAwait(false);
         _logger.LogInformation("PostgreSQL database tables purged successfully");
+
+        // TRUNCATE is not a CRUD command the cache interceptor recognizes, so a purge
+        // (backup restore) must flush the second level cache explicitly.
+        SecondLevelCacheFactory.FlushCache(_logger);
     }
 
     private T? GetCustomDatabaseOption<T>(ICollection<CustomDatabaseOption>? options, string key, Func<string, T> converter, Func<T>? defaultValue = null)
