From ee23424b496fbce9b4090aafc9eab36e1713274e Mon Sep 17 00:00:00 2001
From: Salty <99386653+PjSalty@users.noreply.github.com>
Date: Mon, 13 Jul 2026 09:56:37 -0500
Subject: [PATCH] schema: ensure prod-proven indexes during scheduled
 optimisation

Applied with the scheduled optimiser because upstream's EF model does
not carry them, and all three were first proven live in production:
unique (UserId, Kind) on Permissions and Preferences (a retry loop once
grew Permissions to 251k rows for 11 users, putting the auth join at
3.2s per request) and a filter+sort index for the Latest/browse family
(images p95 1.04s to 160ms under load). Statements live in
Schema/SchemaHardening.cs (overlay); each is idempotent and failure
never stops the pass.
---
 .../Database/PgSqlDatabaseProvider.cs           | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/Jellyfin.Plugin.Pgsql/Database/PgSqlDatabaseProvider.cs b/Jellyfin.Plugin.Pgsql/Database/PgSqlDatabaseProvider.cs
index 972ad9c..8c38141 100644
--- a/Jellyfin.Plugin.Pgsql/Database/PgSqlDatabaseProvider.cs
+++ b/Jellyfin.Plugin.Pgsql/Database/PgSqlDatabaseProvider.cs
@@ -78,6 +78,23 @@ public sealed class PgSqlDatabaseProvider : IJellyfinDatabaseProvider
             {
                 await context.Database.ExecuteSqlRawAsync("VACUUM ANALYZE", cancellationToken).ConfigureAwait(false);
                 _logger.LogInformation("PostgreSQL database optimized successfully");
+
+                foreach (var statement in Schema.SchemaHardening.Statements)
+                {
+                    try
+                    {
+                        await context.Database.ExecuteSqlRawAsync(statement, cancellationToken).ConfigureAwait(false);
+                    }
+                    catch (Exception ex)
+                    {
+                        // 23505 means pre-existing duplicate rows block the unique
+                        // index; dedup is an operator data-fix (cutover runbook
+                        // step 7). Hardening never fails the optimisation pass.
+                        _logger.LogWarning(ex, "Schema hardening statement skipped: {Statement}", statement);
+                    }
+                }
+
+                _logger.LogInformation("PostgreSQL schema hardening ensured");
             }
         }
     }
